{
  "name": "react-thai",
  "version": "0.0.0",
  "description": "Accessible React components for Thai forms: Buddhist-calendar (พ.ศ.) date picker and Thai address autocomplete, plus Thai ID, phone and baht-text helpers.",
  "keywords": [
    "react",
    "thai",
    "thailand",
    "datepicker",
    "buddhist-calendar",
    "buddhist-era",
    "address",
    "autocomplete",
    "postcode",
    "thai-id",
    "bahttext",
    "headless",
    "accessibility"
  ],
  "license": "MIT",
  "author": "Khomkrit Daengnuan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tonklasocute/react-thai.git"
  },
  "homepage": "https://tonklasocute.github.io/react-thai",
  "bugs": "https://github.com/tonklasocute/react-thai/issues",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "THIRD_PARTY_NOTICES.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "date-picker": [
        "./dist/date-picker.d.ts"
      ],
      "address": [
        "./dist/address.d.ts"
      ],
      "thai-id": [
        "./dist/thai-id.d.ts"
      ],
      "phone": [
        "./dist/phone.d.ts"
      ],
      "baht-text": [
        "./dist/baht-text.d.ts"
      ],
      "validators": [
        "./dist/validators.d.ts"
      ],
      "zod": [
        "./dist/zod.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./date-picker": {
      "import": {
        "types": "./dist/date-picker.d.ts",
        "default": "./dist/date-picker.js"
      },
      "require": {
        "types": "./dist/date-picker.d.cts",
        "default": "./dist/date-picker.cjs"
      }
    },
    "./address": {
      "import": {
        "types": "./dist/address.d.ts",
        "default": "./dist/address.js"
      },
      "require": {
        "types": "./dist/address.d.cts",
        "default": "./dist/address.cjs"
      }
    },
    "./thai-id": {
      "import": {
        "types": "./dist/thai-id.d.ts",
        "default": "./dist/thai-id.js"
      },
      "require": {
        "types": "./dist/thai-id.d.cts",
        "default": "./dist/thai-id.cjs"
      }
    },
    "./phone": {
      "import": {
        "types": "./dist/phone.d.ts",
        "default": "./dist/phone.js"
      },
      "require": {
        "types": "./dist/phone.d.cts",
        "default": "./dist/phone.cjs"
      }
    },
    "./baht-text": {
      "import": {
        "types": "./dist/baht-text.d.ts",
        "default": "./dist/baht-text.js"
      },
      "require": {
        "types": "./dist/baht-text.d.cts",
        "default": "./dist/baht-text.cjs"
      }
    },
    "./validators": {
      "import": {
        "types": "./dist/validators.d.ts",
        "default": "./dist/validators.js"
      },
      "require": {
        "types": "./dist/validators.d.cts",
        "default": "./dist/validators.cjs"
      }
    },
    "./zod": {
      "import": {
        "types": "./dist/zod.d.ts",
        "default": "./dist/zod.js"
      },
      "require": {
        "types": "./dist/zod.d.cts",
        "default": "./dist/zod.cjs"
      }
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "size": "size-limit",
    "check:exports": "publint && attw --pack . --exclude-entrypoints styles.css",
    "data:build": "tsx scripts/build-address-data.ts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o storybook-static",
    "test-storybook": "test-storybook",
    "media:capture": "tsx scripts/capture-media.ts",
    "examples:verify": "bash scripts/verify-examples.sh",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "zod": "^3.23.0 || ^4.0.0"
  },
  "peerDependenciesMeta": {
    "zod": {
      "optional": true
    }
  },
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^2.31.1",
    "@eslint/js": "^9.39.5",
    "@hookform/resolvers": "^5.9.2",
    "@size-limit/preset-small-lib": "^11.2.0",
    "@storybook/addon-a11y": "~8.6.19",
    "@storybook/addon-essentials": "~8.6.19",
    "@storybook/addon-interactions": "~8.6.19",
    "@storybook/blocks": "~8.6.19",
    "@storybook/react": "~8.6.19",
    "@storybook/react-vite": "~8.6.19",
    "@storybook/test": "~8.6.19",
    "@storybook/test-runner": "~0.22.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^3.2.7",
    "axe-playwright": "^2.2.2",
    "concurrently": "^9.2.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "gifenc": "^1.0.3",
    "globals": "^17.13.0",
    "http-server": "^14.1.1",
    "jsdom": "^26.1.0",
    "playwright": "^1.64.1",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.90.0",
    "size-limit": "^11.2.0",
    "storybook": "~8.6.19",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^6.4.4",
    "vitest": "^3.2.7",
    "wait-on": "^8.0.5",
    "zod": "^4.6.7",
    "zod3": "npm:zod@^3.25"
  }
}
